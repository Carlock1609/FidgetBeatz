// Cloudflare Worker config for the FidgetBeatz stats counter (ADR 0006).
// Deploy steps: services/stats-counter/README.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fidgetbeatz-stats",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Served only at stats.fidgetbeatz.com. The domain's DNS is on Cloudflare, so deploying creates
  // the DNS record and certificate; no workers.dev URL, so there is one public endpoint.
  "workers_dev": false,
  "routes": [{ "pattern": "stats.fidgetbeatz.com", "custom_domain": true }],
  // Comma-separated exact origins allowed to call the service: the production site and its www
  // redirect. `npm run dev` swaps in http://localhost:3000, so local runs never count here.
  "vars": {
    "ALLOWED_ORIGINS": "https://fidgetbeatz.com,https://www.fidgetbeatz.com",
  },
  "durable_objects": {
    "bindings": [{ "name": "STATS_COUNTER", "class_name": "StatsCounter" }],
  },
  // SQLite-backed Durable Objects are the only kind available on the Workers Free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["StatsCounter"] }],
  "observability": { "enabled": false },
}
