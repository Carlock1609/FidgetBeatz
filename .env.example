# FidgetBeatz environment variables
# Copy to .env.local for local development.
#
# Rules:
# - Never put secrets in NEXT_PUBLIC_* variables; they are shipped to the browser.
# - Document every new variable here and in README.md.

# Set automatically at build time from package.json / git (see ADR 0006). Override only for testing.
# NEXT_PUBLIC_APP_VERSION=0.1.0
# NEXT_PUBLIC_APP_COMMIT=a1b2c3d

# Public base URL of the visitor-stats counter service (ADR 0006). Leave empty to show the offline state.
NEXT_PUBLIC_STATS_URL=
